{
    "name": "telegram-bot-essentials/announcements",
    "description": "Announcements feature built for telegram-bot-essentials/essence",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": ">=12.0",
        "telegram-bot-essentials/essence": "0.12.x-dev"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\Announcements\\": "src/"
        },
        "files": [
            "bootstrap/canvas.php",
            "src/helpers.php"
        ],
        "classmap": [
            "database/factories",
            "database/seeders"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyareranjbar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/telegram-bot-essentials"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\Announcements\\TbeAnnouncementsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.11"
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi",
            "@php vendor/bin/testbench workbench:sync-skeleton --ansi"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    }
}
