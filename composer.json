{
    "name": "telegram-bot-essentials/announcements",
    "description": "Announcements feature built for telegram-bot-essentials/essence",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": ">=12.0",
        "telegram-bot-essentials/essence": ">=0.8.7"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\Announcements\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ],
        "classmap": [
            "database/factories",
            "database/seeders"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyareranjbar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/telegram-bot-essentials"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\Announcements\\TbeAnnouncementsServiceProvider"
            ]
        }
    }
}
